{
  "name": "vhp-shop",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-vhp-shop \"vitest run --config vitest.rules.config.ts\"",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-vhp-shop"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.37.0",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "description": "VHP Shop – dịch vụ tạo website bán hàng riêng cho từng khách"
}
