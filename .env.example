# Firebase (bắt buộc) – lấy trong Firebase Console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Tên miền (tuỳ chọn – có giá trị mặc định, đổi hosting chỉ cần sửa các biến này)
# Tên miền gốc cho tên miền phụ của cửa hàng: ten-cua-hang.<VITE_ROOT_DOMAIN>
VITE_ROOT_DOMAIN=vhphuoc.shop
# Các host chạy trang nền tảng (đăng ký, quản lý...), cách nhau bởi dấu phẩy
VITE_APP_HOSTS=shop.vhphuoc.shop
# Bản ghi DNS khách cần thêm khi gắn tên miền riêng
VITE_CNAME_TARGET=cname.vercel-dns.com
VITE_APEX_IP=76.76.21.21

# Chỉ dùng khi test với Firebase Emulator (đặt trong .env.emulator.local, KHÔNG đặt trong .env.local)
# VITE_FIREBASE_EMULATOR=1
